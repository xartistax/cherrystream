generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODEL
  ADMIN
}

enum WalletTransactionType {
  CREDIT_PURCHASE
  PREMIUM_UNLOCK
  PREMIUM_SALE
  TIP_SENT
  TIP_RECEIVED
  BOOST_PURCHASE
  EARNINGS_CONVERSION
  PAYOUT
  ADJUSTMENT
}

enum WalletBalanceType {
  USER_CREDITS
  EARNINGS
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModelStatus {
  NONE
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  OTHER
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PREMIUM
}

enum ContactChannel {
  PHONE
  WHATSAPP
  TELEGRAM
  SIGNAL
  WEBSITE
  INSTAGRAM
  EMAIL
}

enum AdminAction {
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  USER_SUSPENDED
  USER_REACTIVATED
  POST_HIDDEN
  POST_RESTORED
  INVITE_CREATED
  INVITE_RENEWED
  INVITE_REVOKED
  IMPERSONATION_STARTED
  IMPERSONATION_STOPPED
}

enum InviteStatus {
  OPEN
  CLAIMED
}

/// Who did what in the admin area. Kept when the acting admin is removed.
model AdminAuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AdminAction
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model NotificationSettings {
  userId String @id

  marketingEmails Boolean @default(false)
  accountEmails   Boolean @default(true)

  newFollowers  Boolean @default(true)
  postLikes     Boolean @default(true)
  profileViews  Boolean @default(true)
  contactClicks Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  username             String                @unique
  passwordHash         String?
  name                 String?
  emailVerified        DateTime?
  image                String?
  role                 UserRole              @default(USER)
  status               UserStatus            @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  modelStatus          ModelStatus           @default(NONE)
  notificationSettings NotificationSettings?

  profile  Profile?
  wallet   Wallet?
  accounts Account[]
  sessions Session[]
  posts    Post[]

  following     Follow[]     @relation("Following")
  followers     Follow[]     @relation("Followers")
  postLikes     PostLike[]
  unlockedPosts PostUnlock[]

  receivedProfileViews ProfileView[] @relation("ViewedProfile")
  createdProfileViews  ProfileView[] @relation("ProfileViewer")

  receivedContactClicks ContactClick[] @relation("ContactProfile")
  createdContactClicks  ContactClick[] @relation("ContactVisitor")

  modelVerifications    ModelVerification[] @relation("VerificationSubject")
  reviewedVerifications ModelVerification[] @relation("VerificationReviewer")
  adminAuditLogs        AdminAuditLog[]     @relation("AdminAuditActor")
  createdInvites        ModelInvite[]       @relation("InviteCreator")
  claimedInvite         ModelInvite?        @relation("InviteClaimer")

  @@index([createdAt])
  @@index([status])
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String
  bio         String?
  birthDate   DateTime?
  gender      Gender?
  isPublic    Boolean   @default(true)

  coverUrl      String?
  coverPathname String?

  phoneNumber     String?
  phoneEnabled    Boolean @default(false)
  whatsappEnabled Boolean @default(false)

  telegramUsername String?
  telegramEnabled  Boolean @default(false)

  signalNumber  String?
  signalEnabled Boolean @default(false)

  website        String?
  websiteEnabled Boolean @default(false)

  instagram        String?
  instagramEnabled Boolean @default(false)

  emailPublic  String?
  emailEnabled Boolean @default(false)

  preferredContact ContactChannel?
  contactNote      String?

  verified Boolean @default(false)

  cantonId String?
  canton   Canton? @relation(fields: [cantonId], references: [id])

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories     ProfileCategory[]
  contactMethods ContactMethod[]

  @@index([cantonId])
  @@index([cityId])
  @@index([isPublic])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Post {
  id          String         @id @default(cuid())
  authorId    String
  content     String?
  status      PostStatus     @default(PUBLISHED)
  visibility  PostVisibility @default(PUBLIC)
  unlockPrice Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  unlocks PostUnlock[]

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media  PostMedia[]
  likes  PostLike[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([visibility, createdAt])
}

model PostMedia {
  id     String      @id @default(cuid())
  postId String
  type   MediaType
  status MediaStatus @default(PROCESSING)

  url            String
  pathname       String
  mimeType       String
  size           Int
  sortOrder      Int     @default(0)
  posterUrl      String?
  posterPathname String?
  duration       Float?

  originalUrl      String?
  originalPathname String?

  profileUrl      String?
  profilePathname String?

  feedUrl      String?
  feedPathname String?

  fullUrl      String?
  fullPathname String?

  blurHash String?
  checksum String?

  width  Int?
  height Int?

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([pathname])
  @@index([postId, sortOrder])
  @@index([status])
  @@index([checksum])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model PostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, createdAt])
}

model PostUnlock {
  id String @id @default(cuid())

  userId String
  postId String

  creditsPaid           Int
  grossRappen           Int
  creatorEarningsRappen Int
  platformFeeRappen     Int

  buyerTransactionId   String @unique
  creatorTransactionId String @unique

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  buyerTransaction   WalletTransaction @relation("PostUnlockBuyerTransaction", fields: [buyerTransactionId], references: [id], onDelete: Restrict)
  creatorTransaction WalletTransaction @relation("PostUnlockCreatorTransaction", fields: [creatorTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profiles ProfileCategory[]

  @@index([isActive, sortOrder])
}

model ProfileCategory {
  profileId  String
  categoryId String
  createdAt  DateTime @default(now())

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([profileId, categoryId])
  @@index([categoryId, profileId])
}

model Canton {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)

  cities   City[]
  profiles Profile[]

  createdAt DateTime @default(now())
}

model City {
  id        String    @id @default(cuid())
  slug      String
  name      String
  sortOrder Int       @default(0)
  cantonId  String
  createdAt DateTime  @default(now())
  canton    Canton    @relation(fields: [cantonId], references: [id], onDelete: Cascade)
  profiles  Profile[]

  @@unique([cantonId, slug])
  @@index([cantonId])
}

model ProfileView {
  id String @id @default(cuid())

  profileUserId String
  viewerId      String?

  visitorHash String
  viewedAt    DateTime @default(now())

  profileUser User  @relation("ViewedProfile", fields: [profileUserId], references: [id], onDelete: Cascade)
  viewer      User? @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([profileUserId, viewedAt])
  @@index([profileUserId, visitorHash, viewedAt])
  @@index([viewerId, viewedAt])
}

model ContactClick {
  id String @id @default(cuid())

  profileUserId String
  visitorId     String?

  channel     ContactChannel
  visitorHash String
  clickedAt   DateTime       @default(now())

  profileUser User  @relation("ContactProfile", fields: [profileUserId], references: [id], onDelete: Cascade)
  visitor     User? @relation("ContactVisitor", fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([profileUserId, clickedAt])
  @@index([profileUserId, channel, clickedAt])
  @@index([visitorId, clickedAt])
}

model ContactMethod {
  id String @id @default(cuid())

  profileId String

  channel ContactChannel

  value String

  enabled Boolean @default(true)

  preferred Boolean @default(false)

  sortOrder Int @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

/// Prepared, never public profile draft that a model can claim via a one-time link.
/// Only the SHA-256 hash of the token is stored. Declined invites are deleted, expired ones are removed by the cleanup cron.
model ModelInvite {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  status    InviteStatus @default(OPEN)
  expiresAt DateTime

  displayName      String
  bio              String?
  cantonId         String?
  cityId           String?
  categoryIds      String[]
  phoneNumber      String?
  whatsappEnabled  Boolean  @default(false)
  telegramUsername String?
  instagram        String?
  website          String?

  /// Internal note for admins, e.g. where the contact came from. Never shown to the model.
  sourceNote String?

  createdById String?
  claimedById String?   @unique
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User? @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  claimedBy User? @relation("InviteClaimer", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([phoneNumber])
}

/// Contacts that chose "not interested". Only a hash of the normalised phone number is kept,
/// so they are never invited again without storing who they are.
model DeclinedContact {
  contactHash String   @id
  declinedAt  DateTime @default(now())
}

/// Identity and age check of a model, reviewed manually by an admin.
/// Document pathnames point to private blobs and are cleared once the documents are deleted after review.
model ModelVerification {
  id     String           @id @default(cuid())
  userId String
  status ModerationStatus @default(PENDING)

  challengeCode String

  idDocumentPathname String?
  selfiePathname     String?
  documentsDeletedAt DateTime?

  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?

  user       User  @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
}

model Wallet {
  id             String              @id @default(cuid())
  userId         String              @unique
  userCredits    Int                 @default(0)
  earningsRappen Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String

  type        WalletTransactionType
  balanceType WalletBalanceType

  amountCredits Int?
  amountRappen  Int?

  balanceUserCredits Int @default(0)

  balanceEarningsRappen Int @default(0)

  description String?
  metadata    Json?

  referenceId    String?
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  buyerUnlock   PostUnlock? @relation("PostUnlockBuyerTransaction")
  creatorUnlock PostUnlock? @relation("PostUnlockCreatorTransaction")

  @@index([walletId, createdAt])
  @@index([type, createdAt])
  @@index([referenceId])
}
