DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
# Privater Blob-Store für Ausweisdokumente (fällt sonst auf BLOB_READ_WRITE_TOKEN zurück)
VERIFICATION_BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zahlungen (v0.0.1 deaktiviert)
NEXT_PUBLIC_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-Mail (Resend). Ohne Key werden Mails lokal nur in der Konsole ausgegeben
RESEND_API_KEY=
EMAIL_FROM="CherryStream <noreply@cherrystream.ch>"

# Täglicher Cleanup (Vercel Cron), z. B. openssl rand -hex 32
CRON_SECRET=

# Optional: eigene FFmpeg-Binaries
FFMPEG_PATH=
FFPROBE_PATH=

# Optional: Passwort der Demo-Konten aus pnpm seed:demo (Standard: CherryDemo2026!)
SEED_PASSWORD=
