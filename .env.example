# Vorlage für .env (lokal) und die Variablen in Vercel. Kopieren nach .env und Werte eintragen.
# Nicht hier eintragen: NODE_ENV, CI, VERCEL_* (setzt Vercel) sowie DATABASE_URL_UNPOOLED, BLOB_STORE_ID,
# BLOB_VERIFICATION_STORE_ID und VERCEL_OIDC_TOKEN (setzen die Neon- und Blob-Integrationen bzw. `vercel env pull`).

# Datenbank (Neon). DIRECT_URL = Verbindung ohne Pooler, nur für Migrationen
DATABASE_URL=
DIRECT_URL=

# Auth.js, z. B. openssl rand -base64 32
AUTH_SECRET=

# Öffentliche Basis-URL, für Links in E-Mails und Telegram
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Blob-Stores (Vercel). Privater Store für Ausweisdokumente; ohne eigenen Token fällt er auf BLOB_READ_WRITE_TOKEN zurück
BLOB_READ_WRITE_TOKEN=
VERIFICATION_BLOB_READ_WRITE_TOKEN=

# Kauf von Credits durch Models: test (Testkasse, keine echten Zahlungen) oder live; leer = ausgeblendet
PAYMENTS_MODE=

# Premium-Inhalte für Mitglieder (vorerst ausgeschaltet)
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# E-Mail (Resend). Ohne Key werden Mails lokal nur in der Konsole ausgegeben.
# Ohne eigene Domain: EMAIL_FROM="CherryStream <onboarding@resend.dev>" (stellt nur an die Adresse des Resend-Kontos zu)
RESEND_API_KEY=
EMAIL_FROM="CherryStream <noreply@cherrystream.ch>"
# Nur lokal: alle Mails an diese Adresse umleiten (z. B. die Adresse deines Resend-Kontos im Testmodus)
EMAIL_DEV_REDIRECT=

# Admin-Benachrichtigungen in eine Telegram-Gruppe (optional, Anleitung in docs/telegram.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Error-Tracking (Sentry, optional). DSN für Server und Browser gleich; Org/Projekt/Token nur für Source Maps im Build
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Täglicher Cleanup (Vercel Cron), z. B. openssl rand -hex 32
CRON_SECRET=

# Optional: eigene FFmpeg-Binaries (sonst die mitgelieferten aus ffmpeg-static / @ffprobe-installer)
FFMPEG_PATH=
FFPROBE_PATH=

# Optional, nur lokal: Passwort der Demo-Konten aus pnpm seed:demo (Standard: CherryDemo2026!).
# In Production nur als Prozess-Variable setzen, nie in Vercel (siehe docs/deploy.md)
SEED_PASSWORD=
